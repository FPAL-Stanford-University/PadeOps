&INPUT

inputdir   =  "/home/anagha/Codes/vortex_advection/inclined"      ! Directory for input files
outputdir  = "/home/anagha/Codes/vortex_advection/inclined"      ! Directory for output files

nx = 33                 ! Number of points in X (make change)
ny = 33                 ! Number of points in Y (make change)
nz = 1                  ! Number of points in Z

dt = -1.0D-7              ! Fixed time step value (Set to negative to disable)
tstop = 100.0D0           ! Physical time to stop the simulation
CFL = 0.7D0               ! CFL criterion for calculating the time step (Set to negative to disable)
nsteps = -1               ! Number of time steps before stopping (Set to negative to disable)

tviz = 1.0D-0             ! Time between visualization dumps (Set to negative to disable)
vizprefix = "vortex_adv"   ! Prefix for the visualization files
reduce_precision  = .false.

periodicx = .true.        ! Periodic in X?
periodicy = .true.        ! Periodic in Y?
periodicz = .true.        ! Periodic in Z?

derivative_x = "cd10"     ! What derivative to use in X: "cd10", "cd06", "four", "cheb"
derivative_y = "cd10"     ! What derivative to use in Y: "cd10", "cd06", "four", "cheb"
derivative_z = "cd10"     ! What derivative to use in Z: "cd10", "cd06", "four", "cheb"

filter_x = "cf90"         ! What filter to use in X: "cf90", "gaussian", "lstsq", "spectral"
filter_y = "cf90"         ! What filter to use in X: "cf90", "gaussian", "lstsq", "spectral"
filter_z = "cf90"         ! What filter to use in X: "cf90", "gaussian", "lstsq", "spectral"

xmetric = .false.         ! Streching in x-direction
ymetric = .false.          ! Streching in y-direction
zmetric = .false.          ! Streching in z-direction

prow = 0                  ! Number of rows in 2D processor decomposition (set 0 for auto-tuning)
pcol = 0                  ! Number of rows in 2D processor decomposition (set 0 for auto-tuning)

SkewSymm   = .false.
/

&CINPUT
ns   = 1
gam  = 1.4D0              ! Ratio of specific heats
Rgas = 1.0D0              ! Ratio of specific heats
Cmu   = 0.0D0             ! LAD coeff  
Cbeta = 0.0D0             ! LAD coeff 
Ckap  = 0.0D0             ! LAD coeff 
Cdiff = 0.0D0             ! LAD coeff 
Cy    = 0.0D0             ! LAD coeff 
inviscid = .true.
nrestart = 5000           ! Number of steps between restart dumps
compute_tke_budget = .false.
compute_scale_decomposition = .false.
forcing_cha = .false.
useSGS   = .false.
/

&SGS_MODEL
DynamicProcedureType     =  1        !0=Static  1=Local_mgm  2=Global_mgm
SGSmodelID               =  2        !0=Smagorinsky  1=sigma 2=AMD 3=MGM
useWallDamping           =  .false. 
ncWall                   =  1.0D0
Csgs                     =  1.3D0
Ctke                     =  0.1D0
DynProcFreq              =  1
useSGSDynamicRestartFile =  .false.
DomainAveraged_DynProc   =  .false.
SGSDynamicRestartFile    =  "null"
filter_in_x              =  .true. 
filter_in_y              =  .true.
filter_in_z              =  .true.
testfilter_x             =  "box2"
testfilter_y             =  "box2"   
testfilter_z             =  "box2"
DeltaRatio               =   2.0D0
isEddyViscosityModel     =  .true.
isEddyDiffmodel          =  .true.
isTurbPrandtlconst       =  .false.
useDynamicProcedureScalar=  .false.
PrSGS                    =   0.7D0

/
&PROBINPUT
ns     = 1
Lx     = 20.0D0 !12-stretch,wavy,uniform  !20-incline plane
Ly     = 16.0D0   !12-stretch,wavy,uniform  !16-inclined plane
p_inf  = 1.0D0
rho_inf= 1.0D0
M_inf  = 0.1D0
gam    = 1.4D0
Rgas   = 1.0D0
R_v    = 1.0D0
/

&METRICS
xmetric_flag = 0   !0-Uniform,wavy,incline,    1-stretch
ymetric_flag = 0   !0-Uniform,wavy,incline,    1-stretch
zmetric_flag = 0
metric_params(1,1) = 0.0D0          !! Include it only for stretching>> xmetric_flag=1
metric_params(1,2) = 3.0D0 
metric_params(1,3) = -6.0D0 
metric_params(1,4) = 6.0D0           !1=focus, 2=tau, 3=start, 4=end
metric_params(2,1) = 0.0D0
metric_params(2,2) = 3.0D0 
metric_params(2,3) = -6.0D0 
metric_params(2,4) = 6.0D0           !1=focus, 2=tau, 3=start, 4=end
curvil_flag = 2    !0-Uniform , 2-Rest of the cases
/

